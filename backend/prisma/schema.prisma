datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  INVENTORY_STAFF
  SALES_STAFF
  HR_STAFF
  FINANCE_STAFF
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(SALES_STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// INVENTORY MODULE
model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
}

model Supplier {
  id        String    @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  products  Product[]
}

model Product {
  id            String           @id @default(uuid())
  name          String
  sku           String           @unique
  description   String?
  price         Float
  cost          Float
  quantity      Int              @default(0)
  minStockLevel Int              @default(5)
  categoryId    String
  category      Category         @relation(fields: [categoryId], references: [id])
  supplierId    String?
  supplier      Supplier?        @relation(fields: [supplierId], references: [id])
  orderItems    SalesOrderItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// SALES MODULE
model Customer {
  id          String       @id @default(uuid())
  name        String
  email       String?
  phone       String?
  address     String?
  balance     Float        @default(0.0)
  salesOrders SalesOrder[]
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

model SalesOrder {
  id          String           @id @default(uuid())
  orderNumber String           @unique
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id])
  status      OrderStatus      @default(DRAFT)
  totalAmount Float            @default(0.0)
  items       SalesOrderItem[]
  invoices    Invoice[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model SalesOrderItem {
  id         String     @id @default(uuid())
  orderId    String
  order      SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product    @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Float
  totalPrice Float
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  orderId       String
  order         SalesOrder    @relation(fields: [orderId], references: [id])
  amount        Float
  status        InvoiceStatus @default(UNPAID)
  dueDate       DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// HR MODULE
model Employee {
  id          String       @id @default(uuid())
  firstName   String
  lastName    String
  email       String       @unique
  phone       String?
  department  String
  position    String
  hireDate    DateTime
  salary      Float
  status      String       @default("ACTIVE") // ACTIVE, INACTIVE
  attendance  Attendance[]
  leaves      Leave[]
  payrolls    Payroll[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

model Attendance {
  id         String           @id @default(uuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  date       DateTime         @db.Date
  checkIn    String?
  checkOut   String?
  status     AttendanceStatus @default(PRESENT)
}

enum LeaveType {
  CASUAL
  SICK
  MATERNITY
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Leave {
  id         String      @id @default(uuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id])
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  type       LeaveType
  status     LeaveStatus @default(PENDING)
  reason     String?
}

enum PayrollStatus {
  PENDING
  PAID
}

model Payroll {
  id           String        @id @default(uuid())
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id])
  month        Int
  year         Int
  basicSalary  Float
  allowances   Float         @default(0.0)
  deductions   Float         @default(0.0)
  netSalary    Float
  status       PayrollStatus @default(PENDING)
  paymentDate  DateTime?
}

// FINANCE MODULE
enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id          String          @id @default(uuid())
  type        TransactionType
  amount      Float
  category    String          // e.g. "Sales", "Salaries", "Rent", "Purchases"
  description String?
  date        DateTime        @default(now())
  reference   String?         // Check number, Invoice number, etc.
}
